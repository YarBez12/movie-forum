{{#> big_column}}
<div class="px-8 pt-6 mb-6 flex flex-col items-center">
    <h1 class="m-4 text-2xl xs-phone:text-4xl phone:text-5xl font-extrabold tracking-widest text-white mb-8 text-center">
        Profile
    </h1>
    {{#if error}}
      <div class="mx-8 p-4 mb-4 bg-red-500/20 border border-red-500/50 rounded-2xl text-red-400 text-sm text-center">
        {{error}}
      </div>
    {{/if}}

    <div class="w-full px-6 mb-10">
        <div class="default-card gap-8 flex flex-col md:flex-row items-center p-8 relative overflow-hidden">
                <img
                    src="{{user.avatar.url}}"
                    alt="{{user.username}}"
                    class="w-40 h-40 rounded-3xl object-cover ring-2 ring-white/20 shadow-2xl transition-transform duration-500 group-hover:scale-105"
                />

            <div class="flex-1 text-center md:text-left">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                    <div>
                        <h3 class="text-white font-black text-2xl mb-1">{{user.username}}</h3>
                        <p class="text-white/60 text-sm font-medium">{{user.email}}</p>
                    </div>
                    <button class="filter-action-button text-xs py-3 px-8 self-center md:self-end" id="edit-profile-button">
                        Edit Profile
                    </button>
                </div>
            
            </div>
        </div>
    </div>

    <div class="w-full px-6 mb-10">
        <h2 class="mb-6 text-xl font-bold tracking-widest text-white/80 uppercase text-center md:text-left">
            Your Stats
        </h2>
        <div class="grid grid-cols-1 xs-phone:grid-cols-2 md:grid-cols-4 gap-6">
            {{#> about_stats_card label="Total Plays Of Your Quizzes" value=(formatNumber totalPlays)}}
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            {{/about_stats_card}}

            {{#> about_stats_card label="Completed Quizzes" value=(formatNumber completedQuizzes)}}
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            {{/about_stats_card}}

            {{#> about_stats_card label="Accuracy" value=accuracy}}
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
            {{/about_stats_card}}

            {{#> about_stats_card label="First Quiz Date" value=(formatDate firstQuizDate)}}
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            {{/about_stats_card}}
        </div>
    </div>

    {{> main_divider}}

    <div class="w-full px-6 mb-10">
        <div class="flex items-center justify-between mb-8">
        <h2 class="mb-6 text-xl font-bold tracking-widest text-white/80 uppercase text-center md:text-left">
            Your Added Quizzes
        </h2>
        <button 
        id="add-quiz"
        data-franchise-id="{{franchiseId}}"
        class="flex items-center justify-center h-6 w-6 mini:w-10 mini:h-10 rounded-full bg-white/10 ring-1 ring-white/20 text-white/50 hover:bg-white/20 hover:ring-white/30 hover:text-white/90"
      >
        <svg 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2.5" 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          class="h-4 w-4 mini:w-5 mini:h-5"
        >
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        
      </button>
        </div>

        <div class="grid gap-6 px-4 md:px-6 grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
          {{#each quizzes}}
            {{> quiz_card this user=../user}}
            {{else}}
                <div class="col-span-full py-10 border-2 border-white/5 rounded-3xl flex flex-col items-center justify-center">
                    <p class="text-white/20 text-lg font-medium italic">You haven't created any quizzes yet.</p>
                </div>
          {{/each}}
        </div>
    </div>




    <div class="w-full px-6 mb-10">
        <div class="flex items-center justify-between mb-8">
        <h2 class="mb-6 text-xl font-bold tracking-widest text-white/80 uppercase text-center md:text-left">
            Your Added Franchises
        </h2>
        <button 
        id="add-franchise"
        class="flex items-center justify-center h-6 w-6 mini:w-10 mini:h-10 rounded-full bg-white/10 ring-1 ring-white/20 text-white/50 hover:bg-white/20 hover:ring-white/30 hover:text-white/90"
      >
        <svg 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2.5" 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          class="h-4 w-4 mini:w-5 mini:h-5"
        >
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        
      </button>
        </div>

        <div class="grid gap-6 px-4 md:px-6 grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
          {{#each userFranchises}}
            {{> franchise_card this user=../user}}
            {{else}}
                <div class="col-span-full py-10 border-2 border-white/5 rounded-3xl flex flex-col items-center justify-center">
                    <p class="text-white/20 text-lg font-medium italic">You haven't created any franchises yet.</p>
                </div>
          {{/each}}
        </div>
    </div>
</div>
{{/big_column}}

{{> add_quiz_modal action="/profile/addquiz"}}




{{#> modal id="quiz-delete-confirm-modal" overlay_id="quiz-delete-confirm-overlay"}}
  <div class="p-2">
    <h2 class="text-white/95 font-bold text-xl mb-2">Are you sure?</h2>
    <p class="text-white/60 text-nd mb-6">The quiz will be permanently deleted.</p>
    
    <div class="flex justify-end gap-3">
      <button id="quiz-cancel-delete" class="filter-action-button">Cancel</button>
      <button id="quiz-confirm-delete" class="filter-action-button bg-red-500/20 text-red-400 hover:bg-red-500/40 border-red-500/50">
        Delete
      </button>
    </div>
  </div>
{{/modal}}



{{#> modal id="edit-profile-modal" overlay_id="edit-profile-overlay"}}
        <h2 class="text-white/95 font-bold text-2xl">Edit Profile</h2>

    <form action="/profile/edit" method="POST" enctype="multipart/form-data">
      <div class="space-y-4">
        <div>
            <label class="form-label">Avatar (optional)</label>
            <div id="avatar-preview-container" class="mb-2 relative w-full h-40 rounded-xl overflow-hidden ring-1 ring-white/20">
              <img id="avatar-preview" src="{{user.avatar.url}}" alt="Avatar Preview" class="h-full w-full object-cover">
              <div class="absolute inset-0 flex flex-col justify-end p-3 text-xs text-white/90 font-bold uppercase tracking-widest bg-gradient-to-t from-black/50 to-transparent">
                  Current Avatar
              </div>
            </div>
            <input 
              type="file" 
              name="image" 
              accept="image/*"
              placeholder="Select your avatar image..."
              class="form-field
                  file:mr-4 file:py-2 file:px-4
                  file:rounded-xl file:border-0
                  file:text-xs file:font-bold file:uppercase file:tracking-widest
                  file:bg-white/10 file:text-white/80
                  hover:file:bg-white/20
                  cursor-pointer focus:outline-none"
            >
          </div>
        <div>
          <label class="form-label">Username</label>
          <input 
            type="text" 
            name="username" 
            placeholder="Enter username..."
            value="{{user.username}}"
            required
            autofocus
            class="form-field"
          >
        </div>
        <div>
          <label class="form-label">Email</label>
          <input 
            type="email" 
            name="email" 
            placeholder="Enter email..."
            value="{{user.email}}"
            required
            class="form-field"
          >
        </div>
      </div>

      <div class="mt-5 flex justify-end gap-3">
        <button
          id="cancel-edit-profile"
          type="button"
          class="filter-action-button"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="filter-action-button"
        >
          Save Changes
        </button>
      </div>
    </form>
{{/modal}}


