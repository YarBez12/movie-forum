{{#> big_column}}
<h1 class="text-center m-8 text-3xl font-bold text-white mb-2">
      Create Account
    </h1>

    <form action="/register" method="POST" enctype="multipart/form-data" class="space-y-5 m-8">
      
      <div class="flex flex-col items-center mb-6">
          <div class="w-24 h-24 rounded-full bg-white/10 border-2 border-dashed border-white/20 flex items-center justify-center overflow-hidden cursor-pointer" id="avatar-preview">
            <svg class="w-10 h-10 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <img class="hidden w-full h-full object-cover" />
          </div>
          <input type="file" name="avatar" accept="image/*" class="hidden">
        <span class="text-[10px] text-white/30 mt-2 uppercase tracking-widest">Upload Avatar (optional)</span>
      </div>

      <div>
        <label class="text-white/70 text-xs font-bold uppercase ml-4 mb-1 block">Nickname</label>
        <input type="text" name="username" required placeholder="E.g. MovieFan123"
               class="w-full bg-white/5 ring-1 ring-white/10 rounded-2xl px-5 py-3 text-white outline-none focus:ring-2 focus:ring-white/20 placeholder:text-white/20">
      </div>

      <div>
        <label class="text-white/70 text-xs font-bold uppercase ml-4 mb-1 block">Email</label>
        <input type="email" name="email" required placeholder="email@example.com" autocomplete="email"
               class="w-full bg-white/5 ring-1 ring-white/10 rounded-2xl px-5 py-3 text-white outline-none focus:ring-2 focus:ring-white/20 placeholder:text-white/20">
      </div>

      <div>
        <label class="text-white/70 text-xs font-bold uppercase ml-4 mb-1 block" autocomplete="new-password">Password</label>
        <input type="password" name="password" required placeholder="••••••••"
               class="w-full bg-white/5 ring-1 ring-white/10 rounded-2xl px-5 py-3 text-white outline-none focus:ring-2 focus:ring-white/20 placeholder:text-white/20">
      </div>
      <div>
        <label class="text-white/70 text-xs font-bold uppercase ml-4 mb-1 block">ConfirmPassword</label>
        <input type="password" name="confirmPassword" required placeholder="••••••••"
               class="w-full bg-white/5 ring-1 ring-white/10 rounded-2xl px-5 py-3 text-white outline-none focus:ring-2 focus:ring-white/20 placeholder:text-white/20">
      </div>

      <button type="submit" class="w-full bg-white text-black font-bold p-4 rounded-2xl mt-4 hover:bg-gray-200 uppercase tracking-widest text-sm">
        Create Account
      </button>

      <p class="text-center text-white/30 text-xs mt-6">
        Already have an account? <a href="/login" class="text-white hover:underline">Sign In</a>
      </p>
    </form>
{{/big_column}}