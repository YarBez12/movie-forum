{{!-- Single quiz page --}}
{{#> big_column bg="bg-black/20" blur="backdrop-blur-[8px]"}}
      <div class="px-8 pt-6 mb-6">

        <div class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-3">
          {{> back_button id="quiz-back"}}
          {{#with quiz}}
            <div class="flex-1 min-w-48">
              {{!-- Quiz title --}}
              <div class="text-white/95 font-bold text-2xl">
                {{title}}
              </div>
              {{!-- Quiz stats --}}
              <div class="mt-1 text-white/60 text-sm">
                <span>{{countOfQuestions}} questions</span>
                <span class="text-white/55">•</span>
                <span>~{{durationMinutes}} min</span>
              </div>
            </div>
          {{/with}}

          {{!-- Current quiz score --}}
          <div class="w-full xs-phone:w-auto flex justify-end xs-phone:block">
          <div
            class="relative p-px horizontal-bar-border rounded-full bg-black/10 backdrop-blur-sm px-4 py-2 text-white/70 text-sm"
          >
            Score:
            <span class="text-white/90 font-semibold" id="score-count">0</span>
          </div>
          </div>
        </div>

        {{!-- Quiz questions --}}
        <div class="grid gap-4">
          {{#each questions}}
            {{> quiz_question this}}
          {{/each}}
        </div>
        <div class="mt-5 flex items-center justify-end gap-3">
          <form id="quiz-exit-form" action="/quiz/exit/{{quiz.id}}" method="POST" class="flex items-center justify-end gap-3">
          <input type="hidden" name="score" id="final-score-input" value="0">
          <input type="hidden" name="totalQuestions" id="total-questions" value="{{quiz.countOfQuestions}}">
          <input type="hidden" name="nextURL" id="next-url" value="">
          {{!-- Restart button --}}
          <button
          type="button"
          id="restart-button"
            class="quiz-action-button"
          >
            Restart
          </button>

          {{!-- Finish button --}}
          <button
          type="button"
            id="finish-button"
            class="quiz-action-button"
          >
            Finish
          </button>
          </form>
        </div>
      </div>
{{/big_column}}

{{> quiz_finish_modal id="finish-quiz-modal" 
overlay_id="finish-quiz-modal-overlay" 
title_id="finish-quiz-modal-title" 
subtitle_id="finish-quiz-modal-subtitle" 
close_id="finish-quiz-modal-close" 
message_id="finish-quiz-modal-message"
action_id="finish-quiz-modal-action"
exit_id="finish-quiz-modal-exit"}}
