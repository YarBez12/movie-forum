<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{title}}</title>
  <link rel="stylesheet" href="/css/output.css" />
</head>

<body class="min-h-screen bg-cover bg-center bg-no-repeat app-bg bg-fixed"
{{#if backgroundImg}}style="--custom-bg: url('{{backgroundImg}}');"{{/if}}>
  <div class="relative flex flex-col xl:grid main-grid gap-x-8 gap-y-2 phone:p-10 pb-28 lg:pb-10 min-h-screen items-start lg:items-center">
    
    {{#if user}}
    {{> main_menu}}
    {{/if}}
    {{{body}}}
  </div>
  <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
  {{#each scripts}}
    <script src="/js/{{this}}"></script>
  {{/each}}
</body>

</html>