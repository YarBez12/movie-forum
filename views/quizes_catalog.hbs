<div class="big-column h-full">
  <div
    class="relative rounded-5xl p-px h-full w-full main-block-border overflow-hidden"
  >
    <div
      class="absolute inset-half rounded-5xl bg-white/10 backdrop-blur-tiny overflow-y-auto no-scrollbar"
    >
      <div class="px-8 pt-6 mb-6">
        <div class="mb-5 px-6">
          <div class="text-white/60 text-xs uppercase long-text">
            Catalog
          </div>
          <div class="text-white/95 font-bold text-4xl">
            All quizes
          </div>

          <div
            class="mt-4 h-px w-full bg-gradient-to-r from-white/50 to-transparent"
          ></div>
        </div>
        <div class="mb-5 flex gap-4 px-6">
          <div class="max-w-lg search-field">
            <div class="relative p-px horizontal-bar-border">
              <div class="rounded-full bg-white/10 backdrop-blur-sm">
                <div class="flex items-center gap-3 px-4 py-2">
                  <svg
                    class="text-white/70 w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M21 21l-4.3-4.3"></path>
                  </svg>

                  <input
                    type="text"
                    placeholder="Search..."
                    class="text-sm w-full bg-transparent outline-none text-white/90 placeholder:text-white/50"
                  />
                </div>
              </div>
            </div>
          </div>
          <a class="relative horizontal-bar-border p-px" href="/franshises">
            <span
              class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur-sm px-4 py-2 text-white/90 hover:bg-white/15 transition"
              style="font-size: clamp(12px, 1vw, 14px);"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                style="width:18px;height:18px;"
                class="text-white/80"
              >
                <path d="M12 2l9 5-9 5-9-5 9-5z"></path>
                <path d="M3 12l9 5 9-5"></path>
                <path d="M3 17l9 5 9-5"></path>
              </svg>

              Franchises
            </span>
          </a>
        </div>

        <div class="grid gap-6 px-6 grid-cols-3">
          {{#each quizes}}
            <div
              class="relative rounded-3xl overflow-hidden bg-white/10 block-border"
            >
              <div class="relative h-40 black-fade">
                <img
                  src="{{image}}"
                  alt="{{title}}"
                  class="h-full w-full object-cover"
                />

                <div class="absolute left-4 top-4 z-20">
                  <span
                    class="inline-flex rounded-full bg-black/30 ring-1 ring-white/15 px-3 py-1 text-white/85 backdrop-blur-md text-xs"
                  >
                    {{difficulty}}
                  </span>
                </div>

                <a href="/quiz"
                  class="absolute right-4 top-4 w-9 h-9 grid place-items-center rounded-full bg-black/30 hover:bg-black/80 transition ring-1 ring-white/15 backdrop-blur-md"
                >
                  <svg
                    class="text-white/90 w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M8 5v14l12-7z"></path>
                  </svg>
                </a>

                <div
                  class="absolute left-4 bottom-4 text-white/85 text-xs z-20"
                >
                  <span>{{countOfQuestions}} questions</span>
                  <span class="text-white/55">•</span>
                  <span>~{{durationMinutes}} min</span>
                </div>
              </div>

              <div class="p-4">
                <div class="text-white/95 font-bold text-lg">
                  {{title}}
                </div>
                <div class="mt-1 text-white/70 text-sm">
                  {{description}}
                </div>
              </div>
            </div>
          {{/each}}

        </div>
      </div>
    </div>
  </div>
</div>