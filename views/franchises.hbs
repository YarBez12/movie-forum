{{!-- Catalog with all franchises --}}
{{#> big_column}}
  <div class="px-8 pt-6 mb-6">
    {{!-- Header with type and add buttons --}}
    {{> main_header title="All franchises" add_id="add-franchise"}}
    <div class="mb-5 flex gap-4 px-6">
      {{!-- Back button to previous page --}}
      {{> search_field action="/franchises" value=query id="franchises-search"}}
    </div>
    <div class="px-4 sm:px-7 mb-5">
      <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-y-4">
        {{!-- Label with number of results --}}
        <div class="text-white/60 text-xs order-2 sm:order-none w-full sm:w-auto">
          Found:
          <span class="text-white/85 font-semibold">{{franchises.length}}</span>
          results
        </div>

        {{!-- Sort button --}}
        <div class="flex items-center gap-3 order-1 sm:order-none w-full sm:w-auto">
          {{#> sort_button arrow_id="sort-arrow-icon" id_button="sort-button" menu_id="sort-menu"}}
            {{> sort_menu_option id="titleSortOption" label="Title"}}
            {{> sort_menu_option id="popularitySortOption" label="Popularity"}}
            {{> sort_menu_option id="quizzesCountSortOption" label="Quizzes Count"}}
           {{/sort_button}}
        </div>
      </div>

    </div>

    {{!-- Quizzes cards --}}
    <div class="grid gap-6 px-4 md:px-6 grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
      {{#each franchises}}
        {{> franchise_card this user=../user}}
      {{/each}}
    </div>
  </div>
{{/big_column}}
{{> add_franchise_modal}}
{{> delete_confirm_modal item_name="franchise" modal_id="delete-confirm-modal" overlay_id="delete-confirm-overlay" cancel_id="cancel-delete" confirm_id="confirm-delete"}}