{{!-- Catalog with all franchises --}}
{{#> big_column}}
  <div class="px-8 pt-6 mb-6">
    {{> main_header title="All franchises" add_id="add-franchise"}}
    <div class="mb-5 flex gap-4 px-6">
      {{> back_button action="/quizzes" id="franchises-back"}}
      {{> search_field action="/franchises" value=query id="franchises-search"}}
    </div>

    {{!-- Quizzes cards --}}
    <div class="grid gap-6 px-4 md:px-6 grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
      {{#each franchises}}
        {{> franchise_card this user=../user}}
      {{/each}}
    </div>
  </div>
{{/big_column}}
{{> add_franchise_modal}}


{{#> modal id="delete-confirm-modal" overlay_id="delete-confirm-overlay"}}
  <div class="p-2">
    <h2 class="text-white/95 font-bold text-xl mb-2">Are you sure?</h2>
    <p class="text-white/60 text-nd mb-6">The franchise will be permanently deleted.</p>
    
    <div class="flex justify-end gap-3">
      <button id="cancel-delete" class="filter-action-button">Cancel</button>
      <button id="confirm-delete" class="filter-action-button bg-red-500/20 text-red-400 hover:bg-red-500/40 border-red-500/50">
        Delete
      </button>
    </div>
  </div>
{{/modal}}