{{!-- Catalog with all quizzes --}}
{{#> big_column}}
      <div class="px-8 pt-6 mb-6">
        {{> main_header type="Catalog" title="All quizzes"}}
        <div class="mb-5 flex gap-4 px-6">
          {{> search_field action="/quizzes" value=query id="quizzes-search" }}

          {{!-- Link to all franchises --}}
          <a class="default-button" href="/franchises">
            <span
              class="default-button-inner"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="text-white/80 w-4 h-4"
              >
                <path d="M12 2l9 5-9 5-9-5 9-5z"></path>
                <path d="M3 12l9 5 9-5"></path>
                <path d="M3 17l9 5 9-5"></path>
              </svg>

              Franchises
            </span>
          </a>
        </div>
        <div class="px-7 mb-5">
          <div class="flex items-center justify-between">
            {{!-- Label with number of results --}}
            <div class="text-white/60 text-xs">
              Found:
              <span class="text-white/85 font-semibold">{{quizzes.length}}</span>
              results
            </div>

            {{!-- Filter and sort buttons --}}
            <div class="flex gap-3">
              {{> filter_button id="filter-open"}}

              {{> sort_button arrow_id="sort-arrow-icon" id_button="sort-button" menu_id="sort-menu"}}
            </div>
          </div>

        </div>

        {{!-- Quizzes cards --}}
        <div class="grid gap-6 px-6 grid-cols-3">
          {{#each quizzes}}
            {{> quiz_card this}}
          {{/each}}

        </div>
      </div>
{{/big_column}}

{{> filter_modal id="filter-modal" overlay_id="filter-modal-overlay" close_id="filter-close" form_id="filter-form" reset_id="filter-reset"}}