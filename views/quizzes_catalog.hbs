{{!-- Catalog with all quizzes --}}
{{#> big_column}}
      <div class="px-8 pt-6 mb-6">
        {{> main_header title="All quizzes" add_id="add-quiz"}}
        
        <div class="mb-5 flex flex-col md:flex-row gap-4 px-4 md:px-6">
          <div class="w-full md:flex-1">
          {{> search_field action="/quizzes" value=query id="quizzes-search" }}
          </div>

          {{!-- Link to all franchises --}}
          {{!-- <a class="default-button w-full md:w-auto" href="/franchises">
            <span
              class="default-button-inner w-full justify-center"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="text-white/80 w-4 h-4"
              >
                <path d="M12 2l9 5-9 5-9-5 9-5z"></path>
                <path d="M3 12l9 5 9-5"></path>
                <path d="M3 17l9 5 9-5"></path>
              </svg>

              Franchises
            </span>
          </a> --}}
        </div>
        <div class="px-4 sm:px-7 mb-5">
          <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-y-4">
            {{!-- Label with number of results --}}
            <div class="text-white/60 text-xs order-2 sm:order-none w-full sm:w-auto">
              Found:
              <span class="text-white/85 font-semibold">{{quizzes.length}}</span>
              results
            </div>

            {{!-- Filter and sort buttons --}}
            <div class="flex items-center gap-3 order-1 sm:order-none w-full sm:w-auto">
              {{> filter_button id="filter-open"}}

              {{> sort_button arrow_id="sort-arrow-icon" id_button="sort-button" menu_id="sort-menu"}}
            </div>
          </div>

        </div>

        {{!-- Quizzes cards --}}
        <div class="grid gap-6 px-4 md:px-6 grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
          {{#each quizzes}}
            {{> quiz_card this}}
          {{/each}}

        </div>
      </div>
{{/big_column}}

{{> filter_modal id="filter-modal" overlay_id="filter-modal-overlay" close_id="filter-close" form_id="filter-form" reset_id="filter-reset"}}
{{> add_quiz_modal action="/quizzes/addquiz"}}




{{#> modal id="delete-confirm-modal" overlay_id="delete-confirm-overlay"}}
  <div class="p-2">
    <h2 class="text-white/95 font-bold text-xl mb-2">Are you sure?</h2>
    <p class="text-white/60 text-nd mb-6">The quiz will be permanently deleted.</p>
    
    <div class="flex justify-end gap-3">
      <button id="cancel-delete" class="filter-action-button">Cancel</button>
      <button id="confirm-delete" class="filter-action-button bg-red-500/20 text-red-400 hover:bg-red-500/40 border-red-500/50">
        Delete
      </button>
    </div>
  </div>
{{/modal}}