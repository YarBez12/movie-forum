{{!-- Catalog with all quizzes in the franchise --}}
{{#> big_column bg="phone:bg-black/20" blur="phone:backdrop-blur-[8px]"}}
      <div class="px-8 pt-6 mb-6">
        {{!--Header with type and add buttons --}}
        {{> main_header title=franchise.title add_id="add-quiz" franchiseId=franchise.id}}
        <div class="mb-5 flex gap-4 px-6">
          {{!-- Back button to previous page --}}
          {{> back_button action="javascript:history.back()" id="franchise-detail-back"}}
          {{> search_field action=(concat "/franchises/" franchise.slug) value=query id="franchise-quizzes-search"}}
        </div>
        <div class="px-4 sm:px-7 mb-5">
      <div class="flex flex-wrap sm:flex-nowrap items-center justify-between gap-y-4">
        {{!-- Label with number of results --}}
        <div class="text-white/60 text-xs order-2 sm:order-none w-full sm:w-auto">
          Found:
          <span class="text-white/85 font-semibold">{{quizzes.length}}</span>
          results
        </div>

        {{!-- Sort button --}}
        <div class="flex items-center gap-3 order-1 sm:order-none w-full sm:w-auto">
          {{#> sort_button arrow_id="sort-arrow-icon" id_button="sort-button" menu_id="sort-menu"}}
            {{> sort_menu_option id="popularitySortOption" label="Popularity"}}
            {{> sort_menu_option id="difficultySortOption" label="Difficulty"}}
            {{> sort_menu_option id="publicationDateSortOption" label="Publication Date"}}
            {{> sort_menu_option id="questionsCountSortOption" label="Questions Count"}}
           {{/sort_button}}
        </div>
      </div>

    </div>

        {{!-- Quizzes cards --}}
        <div class="grid gap-6 px-4 md:px-6 grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
          {{#each quizzes}}
            {{> quiz_card this user=../user}}
          {{/each}}

        </div>
      </div>
{{/big_column}}

{{> add_quiz_modal action=(concat "/franchises/" franchise.id "/addquiz")}}

{{> delete_confirm_modal item_name="quiz" modal_id="delete-confirm-modal" overlay_id="delete-confirm-overlay" cancel_id="cancel-delete" confirm_id="confirm-delete" extra_attr=(concat 'data-slug="' franchise.slug '"')}}