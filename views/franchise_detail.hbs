{{!-- Catalog with all quizzes in the franchise --}}
{{#> big_column bg="bg-black/20" blur="backdrop-blur-[8px]"}}
      <div class="px-8 pt-6 mb-6">
        {{> main_header type="Franchise" title=franchise.title}}
        <div class="mb-5 flex gap-4 px-6">
          {{> back_button action="/franchises"}}
          {{> search_field action=(concat "/franchises/" franchise.slug) value=query id="franchise-quizzes-search"}}
        </div>

        {{!-- Quizzes cards --}}
        <div class="grid gap-6 px-6 grid-cols-3">
          {{#each quizzes}}
            {{> quiz_card this}}
          {{/each}}

        </div>
      </div>
{{/big_column}}