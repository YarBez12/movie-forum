<div class="big-column {{#if user}}xl:big-column-desktop{{else}}xl:max-column-desktop{{/if}} xl:h-full w-full">
  <div
    class="relative rounded-5xl p-px min-h-96 phone:h-[calc(100vh-150px)] xl:h-full w-full phone:main-block-border overflow-hidden flex flex-col"
  >
    <div
      class="relative flex-1 xl:absolute xl:inset-half rounded-5xl overflow-y-auto no-scrollbar w-full
      {{#if bg}}{{bg}}{{else}}phone:bg-white/10{{/if}} 
      {{#if blur}}{{blur}}{{else}}phone:backdrop-blur-tiny{{/if}}"
    >
      {{> @partial-block }}
    </div>
  </div>
</div>
