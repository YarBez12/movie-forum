{{!-- Delete confirm modal --}}
{{#> modal id=modal_id overlay_id=overlay_id}}
  <div class="p-2">
    <h2 class="text-white/95 font-bold text-xl mb-2">Are you sure?</h2>
    <p class="text-white/60 text-nd mb-6">The {{item}} will be permanently deleted.</p>
    
    <div class="flex justify-end gap-3">
      <button id={{cancel_id}} class="filter-action-button">Cancel</button>
      {{!-- Confirmation button --}}
      <button id={{confirm_id}} class="filter-action-button bg-red-500/20 text-red-400 hover:bg-red-500/40 border-red-500/50">
        Delete
      </button>
    </div>
  </div>
{{/modal}}