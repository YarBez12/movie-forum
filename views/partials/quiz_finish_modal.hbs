{{!-- Modal window to show quiz results --}}
{{#> modal id=id overlay_id=overlay_id}}
    <div class="flex justify-between">
        {{!-- Modal title and subtitle --}}
      <div>
        <div
          id="{{title_id}}"
          class="text-white/95 font-bold text-xl"
        >
        </div>
        <div id="{{subtitle_id}}" class="mt-1 text-white/70 text-sm">
        </div>
      </div>

        {{!-- Close modal button --}}
      <button
        id="{{close_id}}"
        class="w-9 h-9 rounded-full bg-white/10 ring-1 ring-white/20 text-white/80 hover:bg-white/15 hover:ring-white/40 hover:ring-2"
      >
        ✕
      </button>
    </div>

    {{!-- Message with result --}}
    <div
      id="{{message_id}}"
      class="mt-3 text-white/80 text-md"
    ></div>

    {{!-- Action buttons --}}
    <div class="mt-5 flex justify-end gap-3">
      <button
        id="{{action_id}}"
        class="filter-action-button"
      >
        OK
      </button>

      <button
        id="{{exit_id}}"
        class="filter-action-button"
      >
        Exit
      </button>
    </div>
{{/modal}}
