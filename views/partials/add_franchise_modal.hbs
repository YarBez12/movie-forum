{{#> modal id="add-franchise-modal" overlay_id="add-franchise-modal-overlay"}}
        <h2 class="text-white/95 font-bold text-2xl" id="franchise-modal-title">Create New Franchise</h2>

    <form action="/franchises/addfranchise" method="POST" id="franchise-form" enctype="multipart/form-data">
    <input type="hidden" name="franchiseId" id="edit-franchise-id">
      <div class="space-y-4">
        <div>
          <label class="form-label">Franchise Title</label>
          <input 
            type="text" 
            name="title" 
            placeholder="Enter franchise title..."
            required
            autofocus
            class="form-field"
          >
        </div>

           <div>
            <label class="form-label">Image</label>
            <div id="franchise-image-preview-container" class="hidden mb-2 relative w-full h-40 rounded-xl overflow-hidden ring-1 ring-white/20">
              <img id="franchise-image-preview" src="" alt="Franchise Image Preview" class="h-full w-full object-cover">
              <div class="absolute inset-0 flex flex-col justify-end p-3 text-xs text-white/90 font-bold uppercase tracking-widest bg-gradient-to-t from-black/50 to-transparent">
                  Current Image
              </div>
            </div>
            <input 
              type="file" 
              name="image" 
              accept="image/*"
              placeholder="Select an image for the franchise..."
              class="form-field
                  file:mr-4 file:py-2 file:px-4
                  file:rounded-xl file:border-0
                  file:text-xs file:font-bold file:uppercase file:tracking-widest
                  file:bg-white/10 file:text-white/80
                  hover:file:bg-white/20
                  cursor-pointer focus:outline-none"
            >
          </div>
      </div>

      {{> main_divider}}

      <div class="mt-5 flex justify-end gap-3">
        <button
          id="cancel-add-franchise"
          type="button"
          class="filter-action-button"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="filter-action-button"
          id="franchise-submit-button"
        >
          Create Franchise
        </button>
      </div>
    </form>

{{/modal}}