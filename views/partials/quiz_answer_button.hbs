{{!-- Single answer option for quiz question --}}
<button
  class="answer-button w-full text-left flex gap-3 items-center p-3 rounded-2xl bg-white/5 ring-1 ring-white/25 text-white cursor-pointer hover:bg-white/10 hover:ring-white/40 hover:ring-2"
  data-selected-index="{{@index}}"
>
    {{!-- Letter index --}}
  <span
    class="shrink-0 grid place-items-center w-9 h-9 rounded-full bg-black/25 ring-1 ring-white/10 text-white/90 font-bold text-xs"
  >
    {{index}}
  </span>

    {{!-- Option --}}
  <span class="text-sm">
    {{text}}
  </span>
</button>