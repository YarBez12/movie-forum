{{!-- Edit profile modal --}}
{{#> modal id="edit-profile-modal" overlay_id="edit-profile-overlay"}}
        <h2 class="text-white/95 font-bold text-2xl">Edit Profile</h2>

    <form action="/profile/edit" method="POST" enctype="multipart/form-data">
      <div class="space-y-4">
        <div>
            <label class="form-label">Avatar (optional)</label>
            {{!-- Container with current avatar image --}}
            <div id="avatar-preview-container" class="mb-2 relative w-full h-40 rounded-xl overflow-hidden ring-1 ring-white/20">
              <img id="avatar-preview" src="{{user.avatar.url}}" alt="Avatar Preview" class="h-full w-full object-cover">
              <div class="absolute inset-0 flex flex-col justify-end p-3 text-xs text-white/90 font-bold uppercase tracking-widest bg-gradient-to-t from-black/50 to-transparent">
                  Current Avatar
              </div>
            </div>
            <input 
              type="file" 
              name="image" 
              accept="image/*"
              placeholder="Select your avatar image..."
              class="form-field
                  file:mr-4 file:py-2 file:px-4
                  file:rounded-xl file:border-0
                  file:text-xs file:font-bold file:uppercase file:tracking-widest
                  file:bg-white/10 file:text-white/80
                  hover:file:bg-white/20
                  cursor-pointer focus:outline-none"
            >
          </div>
        <div>
          <label class="form-label">Username</label>
          <input 
            type="text" 
            name="username" 
            placeholder="Enter username..."
            value="{{user.username}}"
            required
            autofocus
            class="form-field"
          >
        </div>
        <div>
          <label class="form-label">Email</label>
          <input 
            type="email" 
            name="email" 
            placeholder="Enter email..."
            value="{{user.email}}"
            required
            class="form-field"
          >
        </div>
      </div>

      <div class="mt-5 flex justify-end gap-3">
        <button
          id="cancel-edit-profile"
          type="button"
          class="filter-action-button"
        >
          Cancel
        </button>
        {{!-- Submit button --}}

        <button
          type="submit"
          class="filter-action-button"
        >
          Save Changes
        </button>
      </div>
    </form>
{{/modal}}