{{!-- Single quiz question --}}
<div
    class="question-section relative main-block-border rounded-5xl p-px overflow-hidden"
    data-question-id="{{id}}"
    data-correct-index="{{correctIndex}}"
>

    <div class="bg-white/10 p-6 flex items-start gap-4">
    {{!-- Question number --}}
    <span
        class="w-12 h-12 rounded-2xl place-items-center grid bg-black/10 text-white/90 font-medium ring-1 ring-white/20"
    >
        {{indexFromOne @index}}
    </span>

    <div class="flex-1">
        {{!-- Question text --}}
        <div class="text-white/95 font-semibold text-lg">
        {{questionText}}
        </div>

        <div class="mt-1 text-white/60 text-xs action-text">
        Choose one answer.
        </div>

        {{!-- Question answer options --}}
        <div class="mt-4 grid gap-3">
        {{#each options}}
            {{> quiz_answer_button index=(answerLetter @index) text=this}}
        {{/each}}
        </div>

        {{!-- Question explanation --}}
        <div class="comment hidden mt-5 relative rounded-2xl p-4">

        {{!-- Explanation header --}}
        <div
            class="flex comment-title items-center gap-2 font-semibold text-sm"
        >
            <div
            class="comment-icon w-5 h-5 rounded-full flex items-center justify-center"
            >
            </div>
            <div class="comment-heading"></div>
        </div>

        {{!-- Explanation text --}}
        <div class="mt-1 text-red-100/80 text-sm">
            {{explanation}}
        </div>

        </div>

    </div>
    </div>
</div>