{{#> modal id="add-quiz-modal" overlay_id="add-quiz-modal-overlay"}}
        <h2 class="text-white/95 font-bold text-2xl" id="quiz-modal-title">Create New Quiz</h2>

    <form action="{{action}}" method="POST" id="quiz-form">
      <input type="hidden" name="quizId" id="edit-quiz-id">
      <div class="space-y-4">
        <div>
          <label class="form-label">Quiz Title</label>
          <input 
            type="text" 
            name="title" 
            placeholder="Enter quiz title..."
            required
            autofocus
            class="form-field"
          >
        </div>

        <div class="grid grid-cols-1 phone:grid-cols-2 gap-4">
          <div>
            <label class="form-label">Franchise</label>
            {{#if franchise}}
            <input type="hidden" name="franchiseSlug" value="{{franchise.slug}}">
                <div class="form-field  text-white/40 cursor-not-allowed">
                {{franchise.title}}
                </div>
            {{else}}
            {{> dropdown id="franchise" name="franchiseId" placeholder="Select franchise" items=franchises required=true}}
            {{/if}}
          </div>

          <div>
            <label class="form-label">Difficulty</label>
            {{#> dropdown id="difficulty" name="difficulty" placeholder="Select difficulty"}}
                  <button type="button" data-value="Easy" class="dropdown-item">Easy</button>
                  <button type="button" data-value="Medium" class="dropdown-item">Medium</button>
                  <button type="button" data-value="Hard" class="dropdown-item">Hard</button>
            {{/dropdown}}
          </div>
        </div>

        <div class="grid grid-cols-1 phone:grid-cols-3 gap-4">
           <div class="phone:col-span-2">
            <label class="form-label">Image</label>
            <input 
              type="text" 
              name="image" 
              placeholder="img"
              class="form-field"
            >
          </div>
          <div>
            <label class="form-label text-xs">Questions Count</label>
            <input 
              type="number" 
              name="countOfQuestions" 
            class="form-field"
            min="1"
            >
          </div>
        </div>

        <div>
            <label class="form-label">Description</label>
          <textarea 
            name="description" 
            rows="2"
            class="form-field"
          ></textarea>
        </div>
      </div>

      {{> main_divider}}
      <div class="flex flex-col gap-4">
        <div id="questions-container" class="space-y-6 max-h-80 overflow-y-auto">
        </div>
        <button type="button" 
                id="add-question"
                class="w-full p-4 rounded-3xl border-2 border-dashed border-white/10 bg-white/5 text-white/50 text-xs font-bold uppercase tracking-widest hover:bg-white/10 hover:border-white/20 hover:text-white/70">
          + Add New Question
        </button>
      </div>

      <div class="mt-5 flex justify-end gap-3">
        <button
          id="cancel-add-quiz"
          type="button"
          class="filter-action-button"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="filter-action-button"
        >
          Create Quiz
        </button>
      </div>
    </form>
    <script id="question-template" type="text/x-handlebars-template">
    <div class="question-block p-5 rounded-3xl bg-white/5 border border-white/10">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-white/80 text-md font-bold tracking-widest question-label">Question \{{indexFromOne questionIndex}}</h3>
            <button type="button" class="remove-question text-white/20 hover:text-red-500 transition-colors">✕</button>
        </div>

      <input 
        type="text" 
        name="questions[\{{questionIndex}}][questionText]" 
        placeholder="Enter your question..."
        required
        class="form-field mb-4"
      >
      <div class="flex flex-col gap-3">
        {{#each (arrayFrom 0 1 2 3)}}
        <div class="flex items-center gap-3">
          <div class="relative flex items-center justify-center">
            <input type="radio" name="questions[\{{questionIndex}}][correctIndex]" value="{{this}}" required class="peer appearance-none w-5 h-5 rounded-full border border-white/20 checked:border-white/60 checked:bg-white/10 cursor-pointer">
            <svg class="absolute w-3 h-3 text-white scale-0 peer-checked:scale-100 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
          </div>
          <input type="text" name="questions[\{{questionIndex}}][options][]" placeholder="Option {{indexFromOne this}}" required class="flex-1 bg-white/5 ring-1 ring-white/10 rounded-lg px-3 py-2 text-xs text-white outline-none focus:ring-white/30">
        </div>
        {{/each}}
      
      </div>
      <div class="mt-4">
        <label class="form-label">Explanation</label>
        <textarea 
          name="questions[\{{questionIndex}}][explanation]" 
          rows="2"
          placeholder="Why is this answer correct?"
          class="form-field"
        ></textarea>
      </div>
    </div>
    </script>
{{/modal}}