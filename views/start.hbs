{{#with info}}
  <div class="big-column h-full">
    <div
      class="relative rounded-5xl p-px h-full w-full main-block-border overflow-hidden"
    >
      <div
        class="absolute inset-half rounded-5xl bg-white/10 backdrop-blur-tiny overflow-y-auto no-scrollbar"
      >
        <div class="px-8 pt-6 mb-6 flex flex-col items-center">
          <h1
            class="m-4 text-5xl font-extrabold tracking-widest text-white"
          >{{title}}</h1>
          <img
            src="img/start-img.jpg"
            class="w-96 rounded-5xl ring-1 ring-white/20"
          />
          <div class="text-white/90 m-4 text-lg space-y-4">
            {{#each descriptions}}
              <p>{{this}}</p>
            {{/each}}

          </div>
        </div>
      </div>
    </div>
  </div>
{{/with}}