<div class="big-column h-full">
  <div
    class="relative rounded-5xl p-px h-full w-full main-block-border overflow-hidden"
  >
    <div
      class="absolute inset-half rounded-5xl bg-white/10 backdrop-blur-tiny overflow-y-auto no-scrollbar"
    >
      <div class="px-8 pt-6 mb-6">
        <div class="mb-5 px-6">
          <div class="text-white/60 text-xs uppercase long-text">
            Catalog
          </div>
          <div class="text-white/95 font-bold text-4xl">
            All franshises
          </div>

          <div
            class="mt-4 h-px w-full bg-gradient-to-r from-white/50 to-transparent"
          ></div>
        </div>
        <div class="mb-5 flex gap-4 px-6">
          <a
            href="/quizes"
            class="relative horizontal-bar-border inline-flex items-center justify-center rounded-full bg-white/10 backdrop-blur-sm w-10 h-10 text-white/90 hover:bg-white/15 transition"
          >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="w-4 h-4 text-white/80"
              >
                <path d="M15 18l-6-6 6-6"></path>
              </svg>
          </a>
          <div class="max-w-lg search-field">
            <div class="relative p-px horizontal-bar-border">
              <div class="rounded-full bg-white/10 backdrop-blur-sm">
                <div class="flex items-center gap-3 px-4 py-2">
                  <svg
                    class="text-white/70 w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="M21 21l-4.3-4.3"></path>
                  </svg>

                  <input
                    type="text"
                    placeholder="Search..."
                    class="text-sm w-full bg-transparent outline-none text-white/90 placeholder:text-white/50"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-6 px-6 grid-cols-3">
          {{#each franshises}}
            <a
              href="/franshises/{{slug}}"
              class="relative overflow-hidden rounded-3xl bg-white/10 block-border black-fade h-48"
            >
              <img
                src="{{image}}"
                alt="{{title}}"
                class="h-full w-full object-cover"
              />

              <div class="absolute left-4 top-4 z-20">
                <span
                  class="inline-flex rounded-full bg-black/30 ring-1 ring-white/15 px-3 py-1 text-white/85 backdrop-blur-md text-xs"
                >
                  {{numberOfQuizes}}
                  quizes
                </span>
              </div>

              <div class="absolute left-6 bottom-6 z-20">
                <div class="text-white/95 font-bold text-lg">
                  {{title}}
                </div>
              </div>
            </a>
          {{/each}}

        </div>
      </div>
    </div>
  </div>
</div>